@model IEnumerable<DimDim.Web.Models.Transacao>
@{
    ViewData["Title"] = "Transações";
}

<h1>Transações</h1>

<p>
    <a asp-action="Create" class="btn btn-dimdim">+ Nova Transação</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>@Html.DisplayNameFor(model => model.Descricao)</th>
            <th>@Html.DisplayNameFor(model => model.Valor)</th>
            <th>@Html.DisplayNameFor(model => model.Tipo)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>@Html.DisplayNameFor(model => model.DataTransacao)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Cliente?.Nome</td>
            <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
            <td>@item.Valor.ToString("C2")</td>
            <td>@item.Tipo</td>
            <td>@item.Status</td>
            <td>@item.DataTransacao.ToString("g")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
